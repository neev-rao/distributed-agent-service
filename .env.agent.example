# Local Gemini development. Copy to ignored .env.agent and configure locally.
# Use a separate Compose project and volume; do not repoint existing fixture work.
POSTGRES_USER=agentservice
POSTGRES_DB=agentservice_ai
POSTGRES_PORT=55434
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://agentservice:local-development-only@127.0.0.1:55434/agentservice_ai?sslmode=disable
# Optional disposable database: create it before database integration tests.
TEST_DATABASE_URL=postgres://agentservice:local-development-only@127.0.0.1:55434/agentservice_test?sslmode=disable
# Select a function-calling model available to your Gemini project.
GEMINI_MODEL=
GEMINI_API_KEY=
