# Local development only. Replace the example password in your ignored .env file.
# These are not production credentials. Keep PostgreSQL bound to loopback.
POSTGRES_USER=agentservice
POSTGRES_DB=agentservice
POSTGRES_PORT=55432
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://agentservice:local-development-only@127.0.0.1:55432/agentservice?sslmode=disable
# Create agentservice_test before running integration tests (see docs/run.md).
TEST_DATABASE_URL=postgres://agentservice:local-development-only@127.0.0.1:55432/agentservice_test?sslmode=disable
